# Variables de entorno del cliente (se completan al ejecutar `npx convex dev`,
# que crea automáticamente el .env.local con los valores reales).

# Deployment utilizado por `npx convex dev`
CONVEX_DEPLOYMENT=

# URL del despliegue Convex para el cliente
NEXT_PUBLIC_CONVEX_URL=

# URL pública del despliegue (termina en .site)
NEXT_PUBLIC_CONVEX_SITE_URL=

# URL local de la app (la usa Better Auth para cookies/verificación)
NEXT_PUBLIC_SITE_URL=

# Secretos de servidor (Better Auth): NO van en este archivo.
# Se configuran con `npx convex env set BETTER_AUTH_SECRET <valor>`
# y `npx convex env set SITE_URL <valor>` en el deployment de Convex.
